    {
        "id": "fn_route_m",
        "type": "function",
        "z": "tab_act_g",
        "name": "Enrutar MQTT",
        "func": "const h = flow.get('hab_activa') || 'hab1';\nlet act = msg.topic;\nlet val = msg.payload;\n\nif (act === 'auxiliar') {\n    if (h === 'hab5') {\n        act = 'toldo';\n        val = (val === 'ON') ? 'ABIERTO' : 'CERRADO';\n    } else {\n        act = 'extractor';\n    }\n}\n\nmsg.topic = `roomsenseg3/${h}/actuadores`;\nmsg.payload = { habitacion: h, actuador: act, valor: val };\nreturn msg;\n",
        "outputs": 1,
        "timeout": "",
        "noerr": 0,
        "initialize": "",
        "finalize": "",
        "libs": [],
        "x": 400,
        "y": 210,
        "wires": [
            [
                "mqtt_out_a"
            ]
        ]
    },
    {
        "id": "mqtt_out_a",
        "type": "mqtt out",
        "z": "tab_act_g",
        "name": "Publicar Orden",
        "topic": "",
        "qos": "",
        "retain": "",
        "respTopic": "",
        "contentType": "",
        "userProps": "",
        "correl": "",
        "expiry": "",
        "broker": "brk_mosq",
        "x": 630,
        "y": 210,
        "wires": []
    },
    {
        "id": "mqtt_in_a",
        "type": "mqtt in",
        "z": "tab_act_g",
        "name": "Confirmación Nodo",
        "topic": "roomsenseg3/+/actuadores",
        "qos": "2",
        "datatype": "json",
        "broker": "brk_mosq",
        "nl": false,
        "rap": false,
        "inputs": 0,
        "x": 170,
        "y": 480,
        "wires": [
            [
                "fn_fmt_a"
            ]
        ]
    },
    {
        "id": "fn_fmt_a",
        "type": "function",
        "z": "tab_act_g",
        "name": "Formatear",
        "func": "msg.payload = `${msg.payload.habitacion.toUpperCase()} (${msg.payload.actuador}) -> ${msg.payload.valor}`;\nreturn msg;\n",
        "outputs": 1,
        "timeout": "",
        "noerr": 0,
        "initialize": "",
        "finalize": "",
        "libs": [],
        "x": 390,
