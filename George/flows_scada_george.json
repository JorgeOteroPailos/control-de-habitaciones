    {
        "id": "inj_sim45",
        "type": "inject",
        "z": "tab_amb45_g",
        "name": "Simular Amb 4 y 5 (5s)",
        "repeat": "5",
        "once": true,
        "onceDelay": 1,
        "x": 160,
        "y": 80,
        "wires": [
            [
                "fn_sim_amb4",
                "fn_sim_amb5"
            ]
        ]
    },
    {
        "id": "fn_sim_amb4",
        "type": "function",
        "z": "tab_amb45_g",
        "name": "Simulador Pasillo (hab4)",
        "func": "const pres = Math.random() > 0.6 ? 1 : 0;\nconst lux = pres ? Math.floor(250 + Math.random()*150) : Math.floor(20 + Math.random()*60);\nmsg.topic = 'roomsenseg3/hab4/sensores';\nmsg.payload = { presencia: pres, luz: lux };\nreturn msg;",
        "outputs": 1,
        "x": 410,
        "y": 60,
        "wires": [
            [
                "mqtt_out_45"
            ]
        ]
    },
    {
        "id": "fn_sim_amb5",
        "type": "function",
        "z": "tab_amb45_g",
        "name": "Simulador Terraza (hab5)",
        "func": "const uv = Number((Math.random()*5).toFixed(1));\nconst lluvia = Math.random() > 0.7 ? 'Lluvia' : 'Seco';\nmsg.topic = 'roomsenseg3/hab5/sensores';\nmsg.payload = { uv: uv, lluvia: lluvia };\nreturn msg;",
        "outputs": 1,
        "x": 410,
        "y": 110,
        "wires": [
            [
                "mqtt_out_45"
            ]
        ]
    },
    {
        "id": "mqtt_out_45",
        "type": "mqtt out",
        "z": "tab_amb45_g",
        "name": "Publicar Amb 4 y 5",
        "broker": "brk_emqx_45",
        "x": 750,
        "y": 40,
        "wires": []
    },
    {
        "id": "mqtt_in_45",
        "type": "mqtt in",
        "z": "tab_amb45_g",
        "name": "Escuchar Todos Ambientes",
        "topic": "roomsenseg3/+/+",
        "datatype": "json",
        "broker": "brk_emqx_45",
        "inputs": 0,
        "x": 160,
        "y": 200,
        "wires": [
            [
                "fn_dist_45"
            ]
        ]
    },
    {
        "id": "fn_dist_45",
        "type": "function",
        "z": "tab_amb45_g",
        "name": "Enrutar a UI y SCADA",
        "func": "const p = msg.topic.split('/');\nconst h = p[1];\nconst tipo = p[2];\nmsg.scada_hab = h;\nmsg.scada_tipo = tipo;\nlet m4 = null, m5 = null;\nif (h === 'hab4' && tipo === 'sensores') m4 = { payload: `Presencia: ${msg.payload.presencia ? 'SÍ' : 'NO'} · Luz: ${msg.payload.luz} lx` };\nif (h === 'hab5' && tipo === 'sensores') m5 = { payload: `Estado: ${msg.payload.lluvia} · Índice UV: ${msg.payload.uv}` };\nreturn [msg, m4, m5];",
        "outputs": 3,
        "x": 410,
        "y": 200,
        "wires": [
            [
                "ui_scada_45"
            ],
            [
                "ui_txt_amb4"
            ],
            [
                "ui_txt_amb5"
            ]
        ]
    },
    {
