        "z": "255856d0d5ad7034",
        "name": "Extraer hab3",
        "func": "const p = msg.payload;\nreturn [\n    { payload: p.temperatura },\n    { payload: p.humedad },\n    { payload: p.co2 },\n    { payload: `${p.luz} lx` },\n    { payload: `Presencia: ${p.presencia ? 'sí' : 'no'} · Ventana: ${p.ventana_abierta ? 'abierta' : 'cerrada'} · Modo: ${p.modo}` }\n];",
