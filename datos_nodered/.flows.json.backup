    {
        "id": "fn_route_m",
        "type": "function",
        "z": "tab_act_g",
        "name": "Enrutar MQTT",
        "func": "const h = flow.get('hab_activa') || 'hab1';\nlet act = msg.topic;\nlet val = msg.payload;\n\nif (act === 'auxiliar') {\n    if (h === 'hab5') {\n        act = 'toldo';\n        val = (val === 'ON') ? 'ABIERTO' : 'CERRADO';\n    } else {\n        act = 'extractor';\n    }\n}\n\nmsg.topic = `roomsenseg3/${h}/actuadores`;\nmsg.payload = { habitacion: h, actuador: act, valor: val };\nreturn msg;\n",
        "outputs": 1,
        "timeout": "",
        "noerr": 0,
        "initialize": "",
        "finalize": "",
        "libs": [],
        "x": 400,
        "y": 210,
        "wires": [
            [
                "mqtt_out_a"
            ]
        ]
    },
