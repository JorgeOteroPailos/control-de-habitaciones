    {
        "id": "cb4b8830c86ffab9",
        "type": "function",
        "z": "255856d0d5ad7034",
        "name": "Simulador habitaciones",
        "func": "// Simulador de sensores virtuales — RoomSense (Grupo 3)\n// Genera un mensaje MQTT por habitación cada vez que el nodo inject dispara.\nconst PREFIJO = 'roomsenseg3';\nconst HABITACIONES = ['hab1', 'hab2', 'hab3'];\n\nconst r = (min, max) => Math.random() * (max - min) + min;\nconst lim = (v, min, max) => Math.min(max, Math.max(min, v));\n// Codespaces trabaja en UTC: calculamos la hora local de Galicia\nconst hora = parseInt(new Date().toLocaleString('en-GB', { timeZone: 'Europe/Madrid', hour: '2-digit', hour12: false }));\nconst deDia = hora >= 8 && hora < 20;\n\nconst estado = context.get('estado') || {};\n\nconst msgs = HABITACIONES.map(h => {\n    // Estado inicial de la habitación (solo la primera vez)\n    const s = estado[h] || { temperatura: r(18, 22), humedad: r(40, 60), co2: r(450, 700) };\n\n    // Evolución suave (random walk) para que los datos parezcan reales\n    s.presencia   = Math.random() < 0.6;                                       // PIR\n    s.temperatura = lim(s.temperatura + r(-0.2, 0.2), 15, 28);                 // SCD30\n    s.humedad     = lim(s.humedad + r(-1, 1), 30, 80);                         // SCD30\n    s.co2         = lim(s.co2 + (s.presencia ? r(5, 25) : r(-20, 0)), 400, 2000); // SCD30: sube con gente\n    s.luz         = Math.round(deDia ? r(300, 800) : r(0, 50));                // luz ambiental (lux)\n    estado[h] = s;\n\n    return {\n        topic: `${PREFIJO}/${h}/sensores`,\n        payload: {\n            habitacion: h,\n            timestamp: new Date().toISOString(),\n            temperatura: +s.temperatura.toFixed(1),   // ºC\n            humedad: +s.humedad.toFixed(1),           // %\n            co2: Math.round(s.co2),                   // ppm\n            luz: s.luz,                               // lux\n            presencia: s.presencia,                   // PIR\n            ventana_abierta: false,                   // sensor Hall\n            modo: 'AUTO'                              // pulsador\n        }\n    };\n});\n\ncontext.set('estado', estado);\nreturn [msgs];   // envía los N mensajes, uno tras otro, por la salida 1\n",
        "outputs": 1,
        "timeout": 0,
        "noerr": 0,
        "initialize": "",
        "finalize": "",
        "libs": [],
        "x": 340,
        "y": 100,
        "wires": [
            [
                "30cc183e7b8b22d5",
                "9f6f6e5f88813e02"
            ]
        ]
    },
